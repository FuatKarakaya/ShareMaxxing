{
  "name": "sharemaxxing-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build:code && npm run db:setup",
    "build:code": "npm run db:generate && tsc",
    "start": "node dist/src/server.js",
    "pretest": "npm run build:code",
    "test": "tsx scripts/test.ts",
    "db:generate": "prisma generate",
    "db:setup": "tsx scripts/database.ts setup",
    "db:test:setup": "tsx scripts/database.ts test:setup",
    "db:reset": "tsx scripts/database.ts reset",
    "db:test:reset": "tsx scripts/database.ts test:reset",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:mock": "tsx prisma/seed-mock.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
