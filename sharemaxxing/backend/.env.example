DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sharemaxxing?schema=public"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
PORT=3000
# Required only for npm run db:seed; do not reuse a real account password.
# SEED_PASSWORD="choose-a-local-demo-password"
# Tests automatically use the same server/credentials with DATABASE_NAME_test.
# Optional override (must end in _test and differ from the development database):
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sharemaxxing_test?schema=public"
