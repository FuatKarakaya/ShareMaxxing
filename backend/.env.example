DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sharemaxxing?schema=public"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
PORT=3000
# Only for the live site (docs/CloudSetup.md). Leave unset for local work.
# FRONTEND_ORIGIN="https://sharemaxxing-web.onrender.com"
# TRUST_PROXY_HOPS=1
# Required only for npm run db:seed; do not reuse a real account password.
# SEED_PASSWORD="choose-a-local-demo-password"
# Tests automatically use the same server/credentials with DATABASE_NAME_test.
# Optional override (must end in _test and differ from the development database):
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sharemaxxing_test?schema=public"

# SMTP provider or a local mail catcher (e.g. Mailpit on port 1025).
# SMTP_URL="smtp://localhost:1025"
# MAIL_FROM="ShareMaxxing <no-reply@example.test>"

# Payments (WBS-10.1). "fake" needs no keys and is the default for local work, tests and CI.
# Put real iyzico sandbox keys in backend/.env (git-ignored) and in the Render Dashboard, never in this file.
# PAYMENT_PROVIDER="fake"
# IYZICO_API_KEY="sandbox-..."
# IYZICO_SECRET_KEY="sandbox-..."
# IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
